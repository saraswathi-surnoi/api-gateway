pipeline{
    agent any
    tools{
        maven 'maven-3.9.8'
    }
    stages {
        stage('checkout') {
            steps {
                git credentialsId: 'git-access', url: 'https://github.com/SurnoiTechnology/API-Gateway-Service-FusionIQ-BE'
            }
        }
        stage('Build and Package'){
            steps{
                sh 'mvn clean package -DskipTests'
            }
        }
         stage('push to s3') {
            steps{
                sh 'aws s3 cp /var/lib/jenkins/workspace/FUSIONIQ/api-gateway/target/api-gateway-0.0.1-SNAPSHOT.jar s3://fusioniq-artifacts/'
            }
        }
    }
}